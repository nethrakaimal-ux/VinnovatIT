font pango:JetBrainsMono Nerd Font 10

# Modifier key (Mod4 = Windows/Super Key)
set $mod Mod4

# Core Navigation & Workspace Shortcuts (Requirement 2)
floating_modifier $mod
bindsym $mod+Return exec kitty
bindsym $mod+d exec rofi -show drun
bindsym $mod+Shift+q kill

# Focus Window
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# Move Window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# Named Workspaces for AI/Web Dev Workflows (Bonus Feature)
set $ws1 "1: WebDev"
set $ws2 "2: Code"
set $ws3 "3: AI/ML"
set $ws4 "4: Terminal"
set $ws5 "5: Design"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# Screenshot Shortcuts (Requirement 2)
bindsym Print exec maim -s ~/Pictures/$(date +%Y-%m-%d-%H%M%S).png

# --- Catppuccin Mocha Color Palette (Requirement 1) ---
# class                 border  backgr. text    indicator child_border
client.focused          #cdd6f4 #1e1e2e #cdd6f4 #89b4fa   #89b4fa
client.focused_inactive #313244 #181825 #a6adc8 #45475a   #45475a
client.unfocused        #313244 #1e1e2e #a6adc8 #45475a   #45475a
client.urgent           #f38ba8 #1e1e2e #f38ba8 #45475a   #f38ba8
client.placeholder      #000000 #0c0c0c #ffffff #000000   #0c0c0c
client.background       #1e1e2e

bar {
    status_command bash ~/.config/scripts/sys_monitor.sh
    position top
    colors {
        background #1e1e2e
        statusline #cdd6f4
        separator  #45475a
        focused_workspace  #89b4fa #89b4fa #11111b
        active_workspace   #313244 #313244 #cdd6f4
        inactive_workspace #1e1e2e #1e1e2e #a6adc8
        urgent_workspace   #f38ba8 #f38ba8 #11111b
    }
}
